{
  "name": "citizenapp-square-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "dev:local": "wrangler dev --local",
    "generate:types": "wrangler types --env-interface CloudflareBindings && node -e \"const fs=require('node:fs');const p='worker-configuration.d.ts';fs.writeFileSync(p,fs.readFileSync(p,'utf8').replace(/[ \\\\t]+$/gm,''));\"",
    "types:check": "sh -c 'before=$(shasum -a 256 worker-configuration.d.ts | cut -d \" \" -f 1); npm run generate:types >/dev/null; after=$(shasum -a 256 worker-configuration.d.ts | cut -d \" \" -f 1); if [ \"$before\" != \"$after\" ]; then echo \"worker-configuration.d.ts 已过期，请运行 npm run generate:types\" >&2; exit 1; fi'",
    "typecheck": "npm run generate:types && tsc --noEmit",
    "test": "vitest run",
    "db:local": "wrangler d1 execute DB --local --file schema/citizenapp.sql",
    "db:production": "wrangler d1 execute DB --remote --file schema/citizenapp.sql",
    "deploy:production": "wrangler deploy"
  },
  "dependencies": {
    "@polkadot/util-crypto": "^14.0.3",
    "aws4fetch": "^1.0.20"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.114.0"
  }
}
